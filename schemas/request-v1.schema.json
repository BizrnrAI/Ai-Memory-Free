{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/BizrnrAI/Ai-Memory-Free/schemas/request-v1.schema.json",
  "title": "Ai-Memory-Free protocol v1 request",
  "type": "object",
  "required": ["action"],
  "properties": {
    "protocol_version": { "const": "1" },
    "action": { "type": "string", "minLength": 1, "maxLength": 64 },
    "namespace": { "type": "string", "pattern": "^[a-zA-Z0-9_.:-]{1,128}$" }
  }
}
