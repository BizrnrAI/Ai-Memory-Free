# Supabase project URL, for example https://PROJECT_REF.supabase.co
SUPABASE_URL=

# Public URL for the deployed memory Edge Function.
# Usually: https://PROJECT_REF.supabase.co/functions/v1/memory
MEMORY_API_URL=

# Optional bootstrap administrator token checked by the Edge Function. Prefer a
# hashed, scoped client token from `npm run token:create -- --name my-agent`.
# Keep this only for initial provisioning and emergency administration.
MEMORY_TOKEN=

# Comma-separated browser origins. Empty means browser CORS is denied while
# backend, curl, and stdio MCP requests (which send no Origin) continue to work.
MEMORY_ALLOWED_ORIGINS=

# Reject high-confidence credential patterns from ordinary semantic memory.
# Store recoverable credentials through the Supabase Vault secret API instead.
MEMORY_REJECT_LIKELY_SECRETS=true

# Optional: audit recall metadata as well as mutations and all secret operations.
# Disabled by default to conserve free-tier database space.
MEMORY_AUDIT_READS=false

# Local MCP safety gate. Secret tools are not registered unless explicitly enabled.
MCP_ENABLE_SECRET_TOOLS=false

# Optional eval setting. Defaults to eval/fixtures.example.json.
MEMORY_EVAL_FIXTURES=eval/fixtures.example.json
