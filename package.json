{
  "name": "ai-memory-free",
  "version": "1.4.0",
  "private": true,
  "description": "A zero-cost, model-agnostic SSOT memory system with Supabase, pgvector, Edge Functions, evals, and MCP integration.",
  "license": "MIT",
  "author": "Kristian Peter (https://kristianpeter.com)",
  "homepage": "https://kristianpeter.com",
  "repository": {
    "type": "git",
    "url": "https://github.com/BizrnrAI/Ai-Memory-Free.git"
  },
  "keywords": [
    "ai-memory",
    "ai-agents",
    "llm-agnostic",
    "mcp",
    "supabase",
    "pgvector"
  ],
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "check": "npm run docs:check && npm run protocol:check && npm run typecheck && npm run typecheck --workspaces --if-present && npm test && npm run eval:fixtures",
    "docs:check": "tsx scripts/validate-docs.ts",
    "protocol:check": "tsx scripts/validate-protocol.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "eval": "tsx scripts/eval.ts",
    "eval:fixtures": "tsx scripts/validate-fixtures.ts",
    "token:create": "tsx scripts/create-client-token.ts",
    "portable": "tsx scripts/portable.ts",
    "document:ingest": "tsx scripts/ingest-document.ts",
    "integrate": "tsx scripts/scaffold-integration.ts",
    "mcp": "npm --workspace @ai-memory-free/mcp-server run dev",
    "test:service": "tsx scripts/test-local-service.ts"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
